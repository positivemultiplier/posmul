{
  "extends": "next/core-web-vitals",
  "settings": {
    "next": {
      "rootDir": "apps/posmul-web/"
    }
  },
  "rules": {
    "@next/next/no-html-link-for-pages": "off",
    "no-console": "warn",
    "no-debugger": "error",
    "prefer-const": "error",
    "no-var": "error",
    "complexity": ["warn", { "max": 15 }]
  }
}
