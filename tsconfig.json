{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "downlevelIteration": true,
    "baseUrl": ".",
    "paths": {
      "@posmul/auth-economy-sdk": [
        "packages/auth-economy-sdk/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/auth-economy-sdk/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "apps/**",
    "scripts/**",
    "out/**",
    "supabase/**"
  ]
}
